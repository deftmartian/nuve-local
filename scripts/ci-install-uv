#!/usr/bin/env bash
# Install the uv release named by UV_VERSION into /usr/local/bin after verifying
# its published SHA-256 checksum. Used by the CI jobs.
set -euo pipefail

: "${UV_VERSION:?UV_VERSION must be set}"
cd "$(mktemp -d)"
tgz=uv-x86_64-unknown-linux-gnu.tar.gz
base="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}"
curl -fsSLO "${base}/${tgz}" && curl -fsSLO "${base}/${tgz}.sha256"
sha256sum -c "${tgz}.sha256"
tar -xzf "${tgz}" --strip-components=1 -C /usr/local/bin \
  uv-x86_64-unknown-linux-gnu/uv uv-x86_64-unknown-linux-gnu/uvx
